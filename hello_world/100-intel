#!/bin/bash

# Check if CFILE is set
if [ -z "$CFILE" ]; then
    echo "Error: CFILE is not set"
    exit 1
fi

# Check if the C file exists
if [ ! -f "$CFILE" ]; then
    echo "Error: C file does not exist"
    exit 1
fi

# Generate assembly code using Intel syntax
gcc -S -masm=intel "$CFILE" -o "${CFILE%.c}.s"

